# Environment Variables for Trip-Tex Application

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/triptex
DB_NAME=triptex

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_secure
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Research & Web Scraping API Keys
# ===============================

# Google Custom Search API
# Get your API key from: https://developers.google.com/custom-search/v1/overview
GOOGLE_SEARCH_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_ENGINE_ID=your-google-search-engine-id

# Bing Web Search API
# Get your API key from: https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_SEARCH_API_KEY=your-bing-search-api-key

# ScrapingBee API (for web scraping)
# Get your API key from: https://www.scrapingbee.com/
SCRAPINGBEE_API_KEY=your-scrapingbee-api-key

# Research Configuration
# ======================

# Maximum number of search results per search engine
MAX_SEARCH_RESULTS=10

# Maximum number of concurrent web scraping requests
MAX_CONCURRENT_SCRAPING=5

# Request timeout for web scraping (in milliseconds)
SCRAPING_TIMEOUT=30000

# Rate limiting for API requests (requests per minute)
SEARCH_API_RATE_LIMIT=100

# File Upload Configuration
# ========================

# Maximum file size for uploads (in bytes)
MAX_FILE_SIZE=10485760

# Allowed file types for uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# Upload directory (relative to project root)
UPLOAD_DIR=uploads

# Security Configuration
# ======================

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
