# Trip-Tex MERN Stack Application .gitignore

# ========================
# NODE.JS / NPM
# ========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm
.node_repl_history

# ========================
# ENVIRONMENT VARIABLES
# ========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.production

# ========================
# BACKEND SPECIFIC
# ========================
# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov/

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output/

# ========================
# REACT / CLIENT SPECIFIC
# ========================
# React build output
client/build/
client/dist/

# Testing
client/coverage/

# React specific
client/.pnp
client/.pnp.js

# ========================
# UPLOADS & USER CONTENT
# ========================
uploads/avatars/*
uploads/vendors/*
uploads/projects/*
# Keep the directories but ignore content
!uploads/avatars/.gitkeep
!uploads/vendors/.gitkeep
!uploads/projects/.gitkeep

# ========================
# DATABASE
# ========================
*.db
*.sqlite
*.sqlite3

# ========================
# IDE / EDITOR
# ========================
.vscode/
.idea/
*.swp
*.swo
*~

# ========================
# OPERATING SYSTEM
# ========================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~

# ========================
# BUILD / DIST
# ========================
dist/
build/
.next/
out/

# ========================
# TEMPORARY FILES
# ========================
*.tmp
*.temp
.cache/
.parcel-cache/

# ========================
# SECURITY
# ========================
*.pem
*.key
*.crt
*.csr

# ========================
# BACKUP FILES
# ========================
*.bak
*.backup
*.old

# ========================
# PACKAGE MANAGERS
# ========================
package-lock.json.bak
yarn.lock.bak